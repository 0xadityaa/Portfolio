{
  "server": "time",
  "command": [
    "uvx",
    "mcp-server-time"
  ],
  "serverInfo": {
    "name": "mcp-time",
    "version": "2026.11.11"
  },
  "protocolVersion": "2025-06-18",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get current time in a specific timezone",
      "inputSchema": {
        "properties": {
          "timezone": {
            "default": "Asia/Kolkata",
            "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.",
            "title": "Timezone",
            "type": "string"
          }
        },
        "type": "object",
        "title": "get_current_timeArguments"
      },
      "name": "get_current_time",
      "outputSchema": {
        "properties": {
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "datetime": {
            "title": "Datetime",
            "type": "string"
          },
          "day_of_week": {
            "title": "Day Of Week",
            "type": "string"
          },
          "is_dst": {
            "title": "Is Dst",
            "type": "boolean"
          }
        },
        "required": [
          "timezone",
          "datetime",
          "day_of_week",
          "is_dst"
        ],
        "type": "object",
        "title": "TimeResult"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Convert time between timezones",
      "inputSchema": {
        "properties": {
          "source_timezone": {
            "default": "Asia/Kolkata",
            "description": "Source IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.",
            "title": "Source Timezone",
            "type": "string"
          },
          "time": {
            "description": "Time to convert in 24-hour format (HH:MM)",
            "title": "Time",
            "type": "string"
          },
          "target_timezone": {
            "default": "Asia/Kolkata",
            "description": "Target IANA timezone name (e.g., 'Asia/Tokyo', 'America/San_Francisco'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.",
            "title": "Target Timezone",
            "type": "string"
          }
        },
        "required": [
          "time"
        ],
        "type": "object",
        "title": "convert_timeArguments"
      },
      "name": "convert_time",
      "outputSchema": {
        "properties": {
          "source": {
            "$ref": "#/$defs/TimeResult"
          },
          "target": {
            "$ref": "#/$defs/TimeResult"
          },
          "time_difference": {
            "title": "Time Difference",
            "type": "string"
          },
          "later_occurrence": {
            "anyOf": [
              {
                "$ref": "#/$defs/LaterOccurrence"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Set only when the source time occurs twice on this date because a clock change repeats it (a DST fall-back): the same conversion at its second occurrence. source and target are the first."
          }
        },
        "required": [
          "source",
          "target",
          "time_difference"
        ],
        "type": "object",
        "$defs": {
          "LaterOccurrence": {
            "description": "The second reading of an ambiguous source time (#5196).",
            "properties": {
              "note": {
                "title": "Note",
                "type": "string"
              },
              "source": {
                "$ref": "#/$defs/TimeResult"
              },
              "target": {
                "$ref": "#/$defs/TimeResult"
              },
              "time_difference": {
                "title": "Time Difference",
                "type": "string"
              }
            },
            "required": [
              "note",
              "source",
              "target",
              "time_difference"
            ],
            "title": "LaterOccurrence",
            "type": "object"
          },
          "TimeResult": {
            "properties": {
              "timezone": {
                "title": "Timezone",
                "type": "string"
              },
              "datetime": {
                "title": "Datetime",
                "type": "string"
              },
              "day_of_week": {
                "title": "Day Of Week",
                "type": "string"
              },
              "is_dst": {
                "title": "Is Dst",
                "type": "boolean"
              }
            },
            "required": [
              "timezone",
              "datetime",
              "day_of_week",
              "is_dst"
            ],
            "title": "TimeResult",
            "type": "object"
          }
        },
        "title": "TimeConversionResult"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Get the time a given number of days, hours, minutes and seconds ago in a specific timezone",
      "inputSchema": {
        "properties": {
          "timezone": {
            "default": "Asia/Kolkata",
            "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.",
            "title": "Timezone",
            "type": "string"
          },
          "days_ago": {
            "default": 0,
            "description": "Whole days before now",
            "minimum": 0,
            "title": "Days Ago",
            "type": "integer"
          },
          "hours_ago": {
            "default": 0,
            "description": "Whole hours before now",
            "minimum": 0,
            "title": "Hours Ago",
            "type": "integer"
          },
          "minutes_ago": {
            "default": 0,
            "description": "Whole minutes before now",
            "minimum": 0,
            "title": "Minutes Ago",
            "type": "integer"
          },
          "seconds_ago": {
            "default": 0,
            "description": "Whole seconds before now",
            "minimum": 0,
            "title": "Seconds Ago",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "get_time_agoArguments"
      },
      "name": "get_time_ago",
      "outputSchema": {
        "properties": {
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "datetime": {
            "title": "Datetime",
            "type": "string"
          },
          "day_of_week": {
            "title": "Day Of Week",
            "type": "string"
          },
          "is_dst": {
            "title": "Is Dst",
            "type": "boolean"
          }
        },
        "required": [
          "timezone",
          "datetime",
          "day_of_week",
          "is_dst"
        ],
        "type": "object",
        "title": "TimeResult"
      }
    }
  ]
}